<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<root>
	<installedComponents>
		<component id="com.analog.crosscore.ssldd.pinmux.component" name="Pin Multiplexing" version="1.0.0" visible="true">
			<component-description><![CDATA[Since some processors have more peripherals than physical pins on the chip, the user needs to configure which peripherals they want enabled and onto which set of pins.  Peripheral configuration requires an in-depth understanding of the hardware.  This component makes it easier to program the peripherals without worrying about the internal details.  The user simply selects the peripherals to enable and this component will generate the C code necessary to configure the peripherals.]]></component-description>
			<product name="Pin Multiplexing Product" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.sru.component" name="SRU Configuration" version="1.0.0" visible="true">
			<component-description><![CDATA[This add-in provides a simplified method of configuring the SHARC Signal Routing Unit (SRU).]]></component-description>
			<product name="Analog Devices Signal Routing Unit" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.ssldd.linkport.common.cortexa5" name="Link Port Driver for Cortex-A" version="1.0.0" visible="false">
			<component-description><![CDATA[This add-in provides Analog Devices' implementation of the Link Port driver]]></component-description>
			<product name="Analog Devices System Services and Device Drivers" version="1.0.0"/>
		</component>
		<component id="com.analog.sourcegen.component.heap_stack" name="Heap and Stack Configuration" version="1.0.0" visible="true">
			<component-description><![CDATA[This component provides the ability to configure the heap and stack memories.]]></component-description>
			<product name="Startup Code/LDF" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.ssldd.pdma.sc59x.cortexa5" name="PDMA Service for Cortex-A" version="1.0.0" visible="false">
			<component-description><![CDATA[This add-in provides Analog Devices' implementation of the Peripheral DMA (PDMA) Service]]></component-description>
			<product name="Analog Devices System Services and Device Drivers" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.ssldd.linkport.sc59x.cortexa5" name="Link Port Driver for Cortex-A" version="2.0.0" visible="true">
			<component-description><![CDATA[This add-in provides Analog Devices' implementation of the Link Port driver]]></component-description>
			<product name="Analog Devices System Services and Device Drivers" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.linkerfiles" name="Linker Files" version="1.0.0" visible="true">
			<component-description><![CDATA[This component adds default Memory Management Unit (MMU) configuration and Linker LD script files to your project. You can then modify these files if you wish to customize them.]]></component-description>
			<product name="Analog Devices implementation of linker files" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.mcapi" name="Analog Devices' MCAPI" version="1.0.0" visible="true">
			<component-description><![CDATA[This add-in provides Analog Devices' implementation of Multicore association's Multicore Communications API (MCAPI™) version 2.15]]></component-description>
			<product name="Analog Devices implementation of Multicore Communications API (MCAPI™) v2.15" version="1.0.0"/>
		</component>
	</installedComponents>
	<configurations>
		<configuration id="com.analog.crosscore.ssldd.pinmux.component">
			<pinmux-configuration processor="ADSP-SC594" version="1.0">
				<peripheral description="Link Port" name="LP0">
					<signal bit="8" mux="2" name="ACK" pin="4" port="B"/>
					<signal bit="12" mux="0" name="CLK" pin="6" port="B"/>
					<signal bit="14" mux="0" name="D0" pin="7" port="B"/>
					<signal bit="16" mux="0" name="D1" pin="8" port="B"/>
					<signal bit="18" mux="0" name="D2" pin="9" port="B"/>
					<signal bit="20" mux="0" name="D3" pin="10" port="B"/>
					<signal bit="22" mux="0" name="D4" pin="11" port="B"/>
					<signal bit="24" mux="0" name="D5" pin="12" port="B"/>
					<signal bit="26" mux="0" name="D6" pin="13" port="B"/>
					<signal bit="28" mux="0" name="D7" pin="14" port="B"/>
				</peripheral>
				<peripheral description="Link Port" name="LP1">
					<signal bit="4" mux="2" name="ACK" pin="2" port="B"/>
					<signal bit="14" mux="0" name="CLK" pin="7" port="C"/>
					<signal bit="30" mux="0" name="D0" pin="15" port="B"/>
					<signal bit="0" mux="0" name="D1" pin="0" port="C"/>
					<signal bit="2" mux="0" name="D2" pin="1" port="C"/>
					<signal bit="4" mux="0" name="D3" pin="2" port="C"/>
					<signal bit="6" mux="0" name="D4" pin="3" port="C"/>
					<signal bit="8" mux="0" name="D5" pin="4" port="C"/>
					<signal bit="10" mux="0" name="D6" pin="5" port="C"/>
					<signal bit="12" mux="0" name="D7" pin="6" port="C"/>
				</peripheral>
				<peripheral description="Two-Wire Interface" name="TWI2">
					<signal bit="28" mux="0" name="SCL" pin="14" port="A"/>
					<signal bit="30" mux="0" name="SDA" pin="15" port="A"/>
				</peripheral>
				<gpio name="Port A">
					<signal bit="28" name="PA14" pin="14" port="A"/>
					<signal bit="30" name="PA15" pin="15" port="A"/>
				</gpio>
				<gpio name="Port B">
					<signal bit="4" name="PB02" pin="2" port="B"/>
					<signal bit="8" name="PB04" pin="4" port="B"/>
					<signal bit="12" name="PB06" pin="6" port="B"/>
					<signal bit="14" name="PB07" pin="7" port="B"/>
					<signal bit="16" name="PB08" pin="8" port="B"/>
					<signal bit="18" name="PB09" pin="9" port="B"/>
					<signal bit="20" name="PB10" pin="10" port="B"/>
					<signal bit="22" name="PB11" pin="11" port="B"/>
					<signal bit="24" name="PB12" pin="12" port="B"/>
					<signal bit="26" name="PB13" pin="13" port="B"/>
					<signal bit="28" name="PB14" pin="14" port="B"/>
					<signal bit="30" name="PB15" pin="15" port="B"/>
				</gpio>
				<gpio name="Port C">
					<signal bit="0" name="PC00" pin="0" port="C"/>
					<signal bit="2" name="PC01" pin="1" port="C"/>
					<signal bit="4" name="PC02" pin="2" port="C"/>
					<signal bit="6" name="PC03" pin="3" port="C"/>
					<signal bit="8" name="PC04" pin="4" port="C"/>
					<signal bit="10" name="PC05" pin="5" port="C"/>
					<signal bit="12" name="PC06" pin="6" port="C"/>
					<signal bit="14" name="PC07" pin="7" port="C"/>
				</gpio>
			</pinmux-configuration>
		</configuration>
