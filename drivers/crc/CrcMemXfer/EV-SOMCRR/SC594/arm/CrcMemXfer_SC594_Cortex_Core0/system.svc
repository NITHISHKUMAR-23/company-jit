<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<root>
	<installedComponents>
		<component id="com.analog.sourcegen.component.heap_stack" name="Heap and Stack Configuration" version="1.0.0" visible="true">
			<component-description><![CDATA[This component provides the ability to configure the heap and stack memories.]]></component-description>
			<product name="Startup Code/LDF" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.linkerfiles" name="Linker Files" version="1.0.0" visible="true">
			<component-description><![CDATA[This component adds a default Abstract Page Table configuration file and Linker LD script to your project. You can then modify these files if you wish to customize them.]]></component-description>
			<product name="Analog Devices implementation of linker files" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.ssldd.crc.common.cortexa5" name="CRC Driver for Cortex-A" version="1.0.0" visible="false">
			<component-description><![CDATA[This add-in provides Analog Devices' implementation of the Cyclic Redundancy Check (CRC) Peripheral Driver
 driver]]></component-description>
			<product name="Analog Devices System Services and Device Drivers" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.ssldd.pwr.sc59x.cortexa5" name="PWR Sevice for Cortex-A" version="2.0.0" visible="true">
			<component-description><![CDATA[This add-in provides Analog Devices' implementation of the Power Service (PWR)]]></component-description>
			<product name="Analog Devices System Services and Device Drivers" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.ssldd.crc.sc59x.cortexa5" name="CRC Driver for Cortex-A" version="2.0.0" visible="true">
			<component-description><![CDATA[This add-in provides Analog Devices' implementation of the Cyclic Redundancy Check (CRC) Peripheral Driver
 driver]]></component-description>
			<product name="Analog Devices System Services and Device Drivers" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.ssldd.pwr.common.cortexa5" name="PWR Sevice for Cortex-A" version="1.0.0" visible="false">
			<component-description><![CDATA[This add-in provides Analog Devices' implementation of the Power Service (PWR)]]></component-description>
			<product name="Analog Devices System Services and Device Drivers" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.ssldd.spu.cortexa5" name="SPU Service for Cortex-A" version="1.0.0" visible="true">
			<component-description><![CDATA[This add-in provides Analog Devices' implementation of the System Protection Unit(SPU)]]></component-description>
			<product name="Analog Devices System Services and Device Drivers" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.ssldd.dma.common.cortexa5" name="DMA Sevice for Cortex-A" version="1.0.0" visible="false">
			<component-description><![CDATA[This add-in provides Analog Devices' implementation of the DMA Service]]></component-description>
			<product name="Analog Devices System Services and Device Drivers" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.ssldd.dma.sc59x.cortexa5" name="DMA Sevice for Cortex-A" version="2.0.0" visible="true">
			<component-description><![CDATA[This add-in provides Analog Devices' implementation of the DMA Service]]></component-description>
			<product name="Analog Devices System Services and Device Drivers" version="1.0.0"/>
		</component>
	</installedComponents>
	<configurations>
		<configuration id="com.analog.sourcegen.component.heap_stack">
			<heap_stack-configuration>
				<crt_and_ldf>
					<propertygroup name="mandatory">
						<property name="si_revision" value="any"/>
						<property name="processor" value="ADSP-SC594"/>
						<property name="product_name" value="CrossCore(R) Embedded Studio"/>
					</propertygroup>
					<ldf>
						<propertygroup name="system_heap" value="L3">
							<property name="size" value="256"/>
							<property name="size_units" value="kB"/>
							<property name="customized" value="true"/>
							<property name="align" value="4"/>
						</propertygroup>
						<propertygroup name="system_stack" value="L1">
							<property name="size_units" value="kB"/>
							<property name="size" value="4"/>
							<property name="customized" value="false"/>
							<property name="align" value="64"/>
						</propertygroup>
						<propertygroup name="supervisor_stack" value="L1">
							<property name="size_units" value="kB"/>
							<property name="customized" value="false"/>
							<property name="align" value="64"/>
							<property name="size" value="4"/>
						</propertygroup>
						<propertygroup name="FIQ_stack" value="L1">
							<property name="customized" value="false"/>
							<property name="size" value="4"/>
							<property name="size_units" value="kB"/>
							<property name="align" value="64"/>
						</propertygroup>
						<propertygroup name="IRQ_stack" value="L1">
							<property name="customized" value="false"/>
							<property name="size" value="4"/>
							<property name="align" value="64"/>
							<property name="size_units" value="kB"/>
						</propertygroup>
						<propertygroup name="abort_stack" value="L1">
							<property name="size_units" value="kB"/>
							<property name="size" value="4"/>
							<property name="customized" value="false"/>
							<property name="align" value="64"/>
						</propertygroup>
						<propertygroup name="undefined_stack" value="L1">
							<property name="size" value="4"/>
							<property name="align" value="64"/>
							<property name="size_units" value="kB"/>
							<property name="customized" value="false"/>
						</propertygroup>
						<property name="heap_stack_src_file" value="app_heap_stack.c"/>
					</ldf>
				</crt_and_ldf>
			</heap_stack-configuration>
		</configuration>
		<configuration id="com.analog.crosscore.addins.linkerfiles">
			<linker-configuration>
				<schema>1.0</schema>
				<linker-config-core-id>0</linker-config-core-id>
				<linker-config-ld-file>L2</linker-config-ld-file>
			</linker-configuration>
		</configuration>
	</configurations>
</root>
