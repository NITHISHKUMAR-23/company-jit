<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<root>
	<installedComponents>
		<component id="com.analog.crosscore.ssldd.pinmux.component" name="Pin Multiplexing" version="1.0.0" visible="true">
			<component-description><![CDATA[Since some processors have more peripherals than physical pins on the chip, the user needs to configure which peripherals they want enabled and onto which set of pins.  Peripheral configuration requires an in-depth understanding of the hardware.  This component makes it easier to program the peripherals without worrying about the internal details.  The user simply selects the peripherals to enable and this component will generate the C code necessary to configure the peripherals.]]></component-description>
			<product name="Pin Multiplexing Product" version="1.0.0"/>
		</component>
		<component id="com.analog.sourcegen.component.heap_stack" name="Heap and Stack Configuration" version="1.0.0" visible="true">
			<component-description><![CDATA[This component provides the ability to configure the heap and stack memories.]]></component-description>
			<product name="Startup Code/LDF" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.linkerfiles" name="Linker Files" version="1.0.0" visible="true">
			<component-description><![CDATA[This component adds default Memory Management Unit (MMU) configuration and Linker LD script files to your project. You can then modify these files if you wish to customize them.]]></component-description>
			<product name="Analog Devices implementation of linker files" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.ssldd.pwr.common.cortexa55" name="PWR Service for Cortex-A" version="1.0.0" visible="false">
			<component-description><![CDATA[This add-in provides Analog Devices' implementation of the Power Service (PWR)]]></component-description>
			<product name="Analog Devices System Services and Device Drivers" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.ssldd.tmr.common.cortexa55" name="TMR Service for Cortex-A" version="1.0.0" visible="false">
			<component-description><![CDATA[This add-in provides Analog Devices' implementation of the General Purpose Timer Service (TMR)]]></component-description>
			<product name="Analog Devices System Services and Device Drivers" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.ssldd.gpio.cortexa55" name="GPIO Service for Cortex-A" version="1.0.0" visible="true">
			<component-description><![CDATA[This add-in provides Analog Devices' implementation of the General-Purpose input/output Port Driver (GPIO)]]></component-description>
			<product name="Analog Devices System Services and Device Drivers" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.ssldd.pwr.sc59x.cortexa55" name="PWR Service for Cortex-A" version="1.0.1" visible="true">
			<component-description><![CDATA[This add-in provides Analog Devices' implementation of the Power Service (PWR)]]></component-description>
			<product name="Analog Devices System Services and Device Drivers" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.ssldd.tmr.sc59x.cortexa55" name="TMR Service for Cortex-A" version="1.0.1" visible="true">
			<component-description><![CDATA[This add-in provides Analog Devices' implementation of the General Purpose Timer Service (TMR)]]></component-description>
			<product name="Analog Devices System Services and Device Drivers" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.ssldd.emsi.sc59x.cortexa55" name="EMSI Driver for Cortex-A" version="1.0.1" visible="true">
			<component-description><![CDATA[This add-in provides Analog Devices' implementation of the EMSI Driver]]></component-description>
			<product name="Analog Devices System Services and Device Drivers" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.ssldd.emsi.common.cortexa55" name="EMSI Driver for Cortex-A" version="1.0.0" visible="false">
			<component-description><![CDATA[This add-in provides Analog Devices' implementation of the EMSI Driver]]></component-description>
			<product name="Analog Devices System Services and Device Drivers" version="1.0.0"/>
		</component>
	</installedComponents>
	<configurations>
		<configuration id="com.analog.crosscore.ssldd.pinmux.component">
			<pinmux-configuration processor="ADSP-SC598" version="1.0">
				<peripheral description="Mobile Storage Host Controller" name="EMSI0">
					<signal bit="30" mux="2" name="CD" pin="15" port="B"/>
					<signal bit="18" mux="1" name="CLK" pin="9" port="E"/>
					<signal bit="2" mux="2" name="CMD" pin="1" port="G"/>
					<signal bit="30" mux="1" name="D0" pin="15" port="D"/>
					<signal bit="2" mux="1" name="D1" pin="1" port="E"/>
					<signal bit="12" mux="2" name="D2" pin="6" port="E"/>
					<signal bit="16" mux="1" name="D3" pin="8" port="E"/>
					<signal bit="4" mux="2" name="D4" pin="2" port="G"/>
					<signal bit="16" mux="1" name="D5" pin="8" port="G"/>
					<signal bit="18" mux="3" name="D6" pin="9" port="G"/>
					<signal bit="20" mux="1" name="D7" pin="10" port="G"/>
					<signal bit="12" mux="1" name="LED_CONTROL" pin="6" port="I"/>
					<signal bit="8" mux="2" name="RST" pin="4" port="C"/>
					<signal bit="12" mux="2" name="WP" pin="6" port="C"/>
				</peripheral>
				<peripheral description="Two-Wire Interface" name="TWI2">
					<signal bit="28" mux="0" name="SCL" pin="14" port="A"/>
					<signal bit="30" mux="0" name="SDA" pin="15" port="A"/>
				</peripheral>
				<gpio name="Port A">
					<signal bit="28" name="PA14" pin="14" port="A"/>
					<signal bit="30" name="PA15" pin="15" port="A"/>
				</gpio>
				<gpio name="Port B">
					<signal bit="30" name="PB15" pin="15" port="B"/>
				</gpio>
				<gpio name="Port C">
					<signal bit="8" name="PC04" pin="4" port="C"/>
					<signal bit="12" name="PC06" pin="6" port="C"/>
				</gpio>
				<gpio name="Port D">
					<signal bit="30" name="PD15" pin="15" port="D"/>
				</gpio>
				<gpio name="Port E">
					<signal bit="2" name="PE01" pin="1" port="E"/>
					<signal bit="12" name="PE06" pin="6" port="E"/>
					<signal bit="16" name="PE08" pin="8" port="E"/>
					<signal bit="18" name="PE09" pin="9" port="E"/>
				</gpio>
				<gpio name="Port G">
					<signal bit="2" name="PG01" pin="1" port="G"/>
					<signal bit="4" name="PG02" pin="2" port="G"/>
					<signal bit="16" name="PG08" pin="8" port="G"/>
					<signal bit="18" name="PG09" pin="9" port="G"/>
					<signal bit="20" name="PG10" pin="10" port="G"/>
				</gpio>
				<gpio name="Port I">
					<signal bit="12" name="PI06" pin="6" port="I"/>
				</gpio>
			</pinmux-configuration>
		</configuration>
		<configuration id="com.analog.sourcegen.component.heap_stack">
			<heap_stack-configuration>
				<crt_and_ldf>
					<propertygroup name="mandatory">
						<property name="si_revision" value="0.0"/>
						<property name="processor" value="ADSP-SC598"/>
						<property name="product_name" value="CrossCore(R) Embedded Studio"/>
					</propertygroup>
					<ldf>
						<propertygroup name="system_heap" value="L3">
							<property name="size" value="100"/>
							<property name="size_units" value="kB"/>
							<property name="customized" value="true"/>
							<property name="align" value="4"/>
						</propertygroup>
						<propertygroup name="EL0_stack" value="L1">
							<property name="size_units" value="kB"/>
							<property name="align" value="64"/>
							<property name="customized" value="false"/>
							<property name="size" value="4"/>
						</propertygroup>
						<propertygroup name="EL3_stack" value="L1">
							<property name="size" value="4"/>
							<property name="size_units" value="kB"/>
							<property name="customized" value="false"/>
							<property name="align" value="64"/>
						</propertygroup>
						<property name="heap_stack_src_file" value="app_heap_stack.c"/>
					</ldf>
				</crt_and_ldf>
			</heap_stack-configuration>
		</configuration>
		<configuration id="com.analog.crosscore.addins.linkerfiles">
			<linker-configuration>
				<schema>1.0</schema>
				<linker-config-core-id>0</linker-config-core-id>
				<linker-config-ld-file>L2</linker-config-ld-file>
			</linker-configuration>
		</configuration>
	</configurations>
</root>
