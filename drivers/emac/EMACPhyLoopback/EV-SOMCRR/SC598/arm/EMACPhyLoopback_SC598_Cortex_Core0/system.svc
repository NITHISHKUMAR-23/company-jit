<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<root>
	<installedComponents>
		<component id="com.analog.crosscore.ssldd.pinmux.component" name="Pin Multiplexing" version="1.0.0" visible="true">
			<component-description><![CDATA[Since some processors have more peripherals than physical pins on the chip, the user needs to configure which peripherals they want enabled and onto which set of pins.  Peripheral configuration requires an in-depth understanding of the hardware.  This component makes it easier to program the peripherals without worrying about the internal details.  The user simply selects the peripherals to enable and this component will generate the C code necessary to configure the peripherals.]]></component-description>
			<product name="Pin Multiplexing Product" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.sru.component" name="SRU Configuration" version="1.0.0" visible="true">
			<component-description><![CDATA[This add-in provides a simplified method of configuring the SHARC Signal Routing Unit (SRU).]]></component-description>
			<product name="Analog Devices Signal Routing Unit" version="1.0.0"/>
		</component>
		<component id="com.analog.sourcegen.component.heap_stack" name="Heap and Stack Configuration" version="1.0.0" visible="true">
			<component-description><![CDATA[This component provides the ability to configure the heap and stack memories.]]></component-description>
			<product name="Startup Code/LDF" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.linkerfiles" name="Linker Files" version="1.0.0" visible="true">
			<component-description><![CDATA[This component adds default Memory Management Unit (MMU) configuration and Linker LD script files to your project. You can then modify these files if you wish to customize them.]]></component-description>
			<product name="Analog Devices implementation of linker files" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.mcapi" name="Analog Devices' MCAPI" version="1.0.0" visible="true">
			<component-description><![CDATA[This add-in provides Analog Devices' implementation of Multicore association's Multicore Communications API (MCAPI™) version 2.15]]></component-description>
			<product name="Analog Devices implementation of Multicore Communications API (MCAPI™) v2.15" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.ssldd.spu.cortexa55" name="SPU Service for Cortex-A" version="1.0.0" visible="true">
			<component-description><![CDATA[This add-in provides Analog Devices' implementation of the System Protection Unit(SPU)]]></component-description>
			<product name="Analog Devices System Services and Device Drivers" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.ssldd.twi.sc59x.cortexa55" name="TWI Driver for Cortex-A" version="1.0.1" visible="true">
			<component-description><![CDATA[This add-in provides Analog Devices' implementation of the Two Wire Interface Driver (TWI)]]></component-description>
			<product name="Analog Devices System Services and Device Drivers" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.ssldd.emac.common.cortexa55" name="EMAC Driver for Cortex-A" version="1.0.0" visible="false">
			<component-description><![CDATA[This add-in provides Analog Devices' implementation of the Ethernet Media Access Controller (EMAC) Driver]]></component-description>
			<product name="Analog Devices System Services and Device Drivers" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.ssldd.gpio.cortexa55" name="GPIO Service for Cortex-A" version="1.0.0" visible="true">
			<component-description><![CDATA[This add-in provides Analog Devices' implementation of the General-Purpose input/output Port Driver (GPIO)]]></component-description>
			<product name="Analog Devices System Services and Device Drivers" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.ssldd.emac.sc59x.cortexa55" name="EMAC Driver for Cortex-A" version="1.0.1" visible="true">
			<component-description><![CDATA[This add-in provides Analog Devices' implementation of the Ethernet Media Access Controller (EMAC) Driver]]></component-description>
			<product name="Analog Devices System Services and Device Drivers" version="1.0.0"/>
		</component>
		<component id="com.analog.crosscore.addins.ssldd.twi.common.cortexa55" name="TWI Driver for Cortex-A" version="1.0.0" visible="false">
			<component-description><![CDATA[This add-in provides Analog Devices' implementation of the Two Wire Interface Driver (TWI)]]></component-description>
			<product name="Analog Devices System Services and Device Drivers" version="1.0.0"/>
		</component>
	</installedComponents>
	<configurations>
		<configuration id="com.analog.crosscore.ssldd.pinmux.component">
			<pinmux-configuration processor="ADSP-SC598" version="1.0">
				<peripheral description="RGMII, RMII, MII Ethernet Controller" name="EMAC0">
					<signal bit="14" mux="1" name="COL" pin="7" port="D"/>
					<signal bit="4" mux="2" name="CRS" pin="2" port="D"/>
					<signal bit="6" mux="0" name="MDC" pin="3" port="H"/>
					<signal bit="8" mux="0" name="MDIO" pin="4" port="H"/>
					<signal bit="24" mux="2" name="PHYINT" pin="12" port="D"/>
					<signal bit="4" mux="1" name="PTPAUX_MCG_IN0" pin="2" port="I"/>
					<signal bit="10" mux="InputTap" name="PTPAUX_MCG_IN1" pin="5" port="D"/>
					<signal bit="6" mux="InputTap" name="PTPAUX_MCG_IN2" pin="3" port="D"/>
					<signal bit="18" mux="InputTap" name="PTPAUX_MCG_IN3" pin="9" port="E"/>
					<signal bit="2" mux="1" name="PTPCLKIN0" pin="1" port="I"/>
					<signal bit="8" mux="2" name="PTPPPS0" pin="4" port="I"/>
					<signal bit="6" mux="2" name="PTPPPS1" pin="3" port="I"/>
					<signal bit="10" mux="0" name="PTPPPS2" pin="5" port="I"/>
					<signal bit="12" mux="0" name="PTPPPS3" pin="6" port="I"/>
					<signal bit="14" mux="0" name="RXCLK_REFCLK" pin="7" port="H"/>
					<signal bit="16" mux="0" name="RXCTL_RXDV" pin="8" port="H"/>
					<signal bit="10" mux="0" name="RXD0" pin="5" port="H"/>
					<signal bit="12" mux="0" name="RXD1" pin="6" port="H"/>
					<signal bit="22" mux="0" name="RXD2" pin="11" port="H"/>
					<signal bit="24" mux="0" name="RXD3" pin="12" port="H"/>
					<signal bit="12" mux="1" name="RXERR" pin="6" port="D"/>
					<signal bit="28" mux="0" name="TXCLK" pin="14" port="H"/>
					<signal bit="26" mux="0" name="TXCTL_TXEN" pin="13" port="H"/>
					<signal bit="18" mux="0" name="TXD0" pin="9" port="H"/>
					<signal bit="20" mux="0" name="TXD1" pin="10" port="H"/>
					<signal bit="30" mux="0" name="TXD2" pin="15" port="H"/>
					<signal bit="0" mux="0" name="TXD3" pin="0" port="I"/>
				</peripheral>
				<peripheral description="RMII Ethernet Controller" name="EMAC1">
					<signal bit="6" mux="0" name="CRS" pin="3" port="F"/>
					<signal bit="4" mux="0" name="MDC" pin="2" port="F"/>
					<signal bit="2" mux="0" name="MDIO" pin="1" port="F"/>
					<signal bit="22" mux="0" name="REFCLK" pin="11" port="E"/>
					<signal bit="30" mux="0" name="RXD0" pin="15" port="E"/>
					<signal bit="0" mux="0" name="RXD1" pin="0" port="F"/>
					<signal bit="26" mux="0" name="TXD0" pin="13" port="E"/>
					<signal bit="28" mux="0" name="TXD1" pin="14" port="E"/>
					<signal bit="24" mux="0" name="TXEN" pin="12" port="E"/>
				</peripheral>
				<peripheral description="Two-Wire Interface" name="TWI2">
					<signal bit="28" mux="0" name="SCL" pin="14" port="A"/>
					<signal bit="30" mux="0" name="SDA" pin="15" port="A"/>
				</peripheral>
				<gpio name="Port A">
					<signal bit="28" name="PA14" pin="14" port="A"/>
					<signal bit="30" name="PA15" pin="15" port="A"/>
				</gpio>
				<gpio name="Port D">
					<signal bit="4" name="PD02" pin="2" port="D"/>
					<signal bit="6" name="PD03" pin="3" port="D"/>
					<signal bit="10" name="PD05" pin="5" port="D"/>
					<signal bit="12" name="PD06" pin="6" port="D"/>
					<signal bit="14" name="PD07" pin="7" port="D"/>
					<signal bit="24" name="PD12" pin="12" port="D"/>
				</gpio>
				<gpio name="Port E">
					<signal bit="18" name="PE09" pin="9" port="E"/>
					<signal bit="22" name="PE11" pin="11" port="E"/>
					<signal bit="24" name="PE12" pin="12" port="E"/>
					<signal bit="26" name="PE13" pin="13" port="E"/>
					<signal bit="28" name="PE14" pin="14" port="E"/>
					<signal bit="30" name="PE15" pin="15" port="E"/>
				</gpio>
				<gpio name="Port F">
					<signal bit="0" name="PF00" pin="0" port="F"/>
					<signal bit="2" name="PF01" pin="1" port="F"/>
					<signal bit="4" name="PF02" pin="2" port="F"/>
					<signal bit="6" name="PF03" pin="3" port="F"/>
				</gpio>
				<gpio name="Port H">
					<signal bit="6" name="PH03" pin="3" port="H"/>
					<signal bit="8" name="PH04" pin="4" port="H"/>
					<signal bit="10" name="PH05" pin="5" port="H"/>
					<signal bit="12" name="PH06" pin="6" port="H"/>
					<signal bit="14" name="PH07" pin="7" port="H"/>
					<signal bit="16" name="PH08" pin="8" port="H"/>
					<signal bit="18" name="PH09" pin="9" port="H"/>
					<signal bit="20" name="PH10" pin="10" port="H"/>
					<signal bit="22" name="PH11" pin="11" port="H"/>
					<signal bit="24" name="PH12" pin="12" port="H"/>
					<signal bit="26" name="PH13" pin="13" port="H"/>
					<signal bit="28" name="PH14" pin="14" port="H"/>
					<signal bit="30" name="PH15" pin="15" port="H"/>
				</gpio>
				<gpio name="Port I">
					<signal bit="0" name="PI00" pin="0" port="I"/>
					<signal bit="2" name="PI01" pin="1" port="I"/>
					<signal bit="4" name="PI02" pin="2" port="I"/>
					<signal bit="6" name="PI03" pin="3" port="I"/>
					<signal bit="8" name="PI04" pin="4" port="I"/>
					<signal bit="10" name="PI05" pin="5" port="I"/>
					<signal bit="12" name="PI06" pin="6" port="I"/>
				</gpio>
			</pinmux-configuration>
		</configuration>
