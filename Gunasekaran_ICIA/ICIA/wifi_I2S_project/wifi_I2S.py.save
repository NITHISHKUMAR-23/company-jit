from flask import Flask, request
import subprocess

app= Flask(__name__)
@app.route('/upload',methods=['POST'])
def upload():
   file =request.files['file']
   file.save("received.wav")
   print("WAV received , playing...")
   subprocess.run(["aplay","received.wav"])
   return "wav received and played over audio output\n"

app.run(host="0.0.0.0",port=5000)

