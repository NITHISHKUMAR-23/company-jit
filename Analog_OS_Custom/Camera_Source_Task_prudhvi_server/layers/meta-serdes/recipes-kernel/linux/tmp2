FILESEXTRAPATHS:prepend := "${THISDIR}/files:"

# Add our driver sources + kernel config fragment
SRC_URI += " \
    file://serdes.cfg \
    file://maxim-serdes/Kconfig \
    file://maxim-serdes/Makefile \
    file://maxim-serdes/max_ser.c \
    file://maxim-serdes/max_ser.h \
    file://maxim-serdes/max_des.c \
    file://maxim-serdes/max_des.h \
    file://maxim-serdes/max_serdes.c \
    file://maxim-serdes/max_serdes.h \
    file://maxim-serdes/max_aggregator.c \
    file://maxim-serdes/max_aggregator.h \
    file://maxim-serdes/max96717.c \
    file://maxim-serdes/max96724.c \
"

# Apply kernel config fragment (enables our drivers)
KERNEL_FEATURES:append = " /serdes.cfg"

# Copy driver into kernel tree before do_patch
do_configure:prepend() {
    echo ">>> Copying Maxim SerDes driver sources into kernel tree"
    install -d ${S}/drivers/media/i2c/maxim-serdes
    cp -r ${WORKDIR}/maxim-serdes/* ${S}/drivers/media/i2c/maxim-serdes/
}

# Patch Kconfig & Makefile automatically
do_patch:append() {
    echo ">>> Patching drivers/media/i2c/Kconfig"
    if ! grep -q "source \"drivers/media/i2c/maxim-serdes/Kconfig\"" ${S}/drivers/media/i2c/Kconfig; then
        echo 'source "drivers/media/i2c/maxim-serdes/Kconfig"' >> ${S}/drivers/media/i2c/Kconfig
    fi

    echo ">>> Patching drivers/media/i2c/Makefile"
    if ! grep -q "maxim-serdes" ${S}/drivers/media/i2c/Makefile; then
        echo 'obj-y += maxim-serdes/' >> ${S}/drivers/media/i2c/Makefile
    fi
}
