   MEM_DMC0_SDRAM_CUSTPP_CODE_A4		        { TYPE(BW RAM) START(0x80EFDC60) END(0x80FF7C5F) WIDTH(8) }			//customer PP code (1MB in 8 bit)     
   RESERVED_PP_CODE_A5   	 					{ TYPE(BW RAM) START(0x80FFDC60) END(0x80ffffff) WIDTH(8) }
 
 
   MEM_DMC0_SDRAM_DDPLAS_OAR_MD_DATA_A6     	{ TYPE(BW RAM) START(0x81000000) END(0x8107ffff) WIDTH(8) } 
   MEM_DMC0_SDRAM_INTERDSP_DATA_A6				{ TYPE(BW RAM) START(0x81080000) END(0x8109ffff) WIDTH(8) }   
   MEM_DMC0_SDRAM_COMMON_INTRINSIC_DATA_A6  	{ TYPE(BW RAM) START(0x810a0000) END(0x810bffff) WIDTH(8) }    
   MEM_DMC0_SDRAM_DDPLUS_DATA_A6       			{ TYPE(BW RAM) START(0x810c0000) END(0x82efffff) WIDTH(8) } // 248 MBits
   DTSX_LIB_DATA_SDRAM_A6						{ TYPE(BW RAM) START(0x82f00000) END(0x831FFFFF) WIDTH(8) }
   DTSX_KERNEL_DATA_SDRAM_A6					{ TYPE(BW RAM) START(0x83200000) END(0x833FFDFF) WIDTH(8) }
   KERNEL_DATA_SDRAM_A6_SPDIF					{ TYPE(BW RAM) START(0x833FFE00) END(0x833FFFFF) WIDTH(8) }
   LIBRARIES_DATA_SDRAM_A6						{ TYPE(BW RAM) START(0x83400000) END(0x835FFFFF) WIDTH(8) }
   KERNEL_DATA_SDRAM_A6							{ TYPE(BW RAM) START(0x83600000) END(0x837F3FFF) WIDTH(8) }
