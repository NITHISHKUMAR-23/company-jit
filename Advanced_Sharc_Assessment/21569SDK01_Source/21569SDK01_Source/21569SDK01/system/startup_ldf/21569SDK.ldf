 //  mem_DMC0_SDRAM_A2       { TYPE(BW RAM) START(0x80a00000) END(0x87ffffff) WIDTH(8) }

   SYSTEM_MEM_SDRAM_A1      					{ TYPE(BW RAM) START(0x80000000) END(0x800fffff) WIDTH(8) }
   MEM_KERNEL_DATA_A1      						{ TYPE(BW RAM) START(0x80100000) END(0x802fffff) WIDTH(8) }
   RERSERVED_PP_CODE_A2       					{ TYPE(BW RAM) START(0x80300000) END(0x805fffff) WIDTH(8) }
   
