  #define MY_SDRAM_MAT_MEM 						MEM_DMC0_SDRAM_MAT_DATA_A3

  #define MY_SDRAM_SWCODE_COMMON_INTRINSIC_MEM 	MEM_DMC0_SDRAM_COMMON_INTRINSIC_CODE_A4  
  #define MY_SDRAM_COMMON_INTRINSIC_MEM   		MEM_DMC0_SDRAM_COMMON_INTRINSIC_DATA_A6   
  
