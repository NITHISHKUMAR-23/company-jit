   MEM_DMC0_SDRAM_TRUEHD_DATA_A3       			{ TYPE(BW RAM) START(0x80700100) END(0x80757Dff) WIDTH(8) }    
   MEM_DMC0_SDRAM_MAT_DATA_A3          			{ TYPE(BW RAM) START(0x80757e00) END(0x80998fff) WIDTH(8) }   
   RESERVED_DATA             		    		{ TYPE(BW RAM) START(0x80999000) END(0x809fffff) WIDTH(8) }   
   
   MEM_DMC0_SDRAM_TRUEHD_CODE_A4            	{ TYPE(BW RAM) START(0x80a00000) END(0x80A2Bfff) WIDTH(8) } 
   MEM_DMC0_SDRAM_MAT_CODE_A4               	{ TYPE(BW RAM) START(0x80A2c000) END(0x80A60fff) WIDTH(8) }
   MEM_DMC0_SDRAM_DDPLUS_CODE_A4       			{ TYPE(BW RAM) START(0x80A61000) END(0x80AEEfff) WIDTH(8) } 
   MEM_DMC0_SDRAM_COMMON_INTRINSIC_CODE_A4  	{ TYPE(BW RAM) START(0x80AEf000) END(0x80b0ffff) WIDTH(8) } 
   MEM_DMC0_SDRAM_COMMON_LIB_C_CODE_A4      	{ TYPE(BW RAM) START(0x80b10000) END(0x80b3ffff) WIDTH(8) }  
   MEM_DMC0_SDRAM_AAC_CODE_A4                   { TYPE(BW RAM) START(0x80b40000) END(0x80b61fff) WIDTH(8) }
   MEM_DMC0_SDRAM_DSD2PCM_CODE_A4               { TYPE(BW RAM) START(0x80b62000) END(0x80b66fff) WIDTH(8) } 
   SDRAM_SPDIF_CODE_A4							{ TYPE(BW RAM) START(0x80b67000) END(0x80b67fff) WIDTH(8) }
   LIBC_DATA_SDRAM_A4	   			            { TYPE(BW RAM) START(0x80b68000) END(0x80b7ffff) WIDTH(8) }  
   DTSX_LIB_CODE_SDRAM_A4		          		{ TYPE(BW RAM) START(0x80b80000) END(0x80c7ffff) WIDTH(8) }
   DTSX_KERNEL_CODE_SDRAM_A4	           		{ TYPE(BW RAM) START(0x80c80000) END(0x80ccffff) WIDTH(8) }
   LIBRARIES_CODE_SDRAM_A4		                { TYPE(BW RAM) START(0x80cd0000) END(0x80ceffff) WIDTH(8) }
   //KERNEL_CODE_SDRAM_A4			                { TYPE(BW RAM) START(0x80cf0000) END(0x80CF9FFF) WIDTH(8) } 
