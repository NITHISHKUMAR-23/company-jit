   RESERVED_DEC_DATA_A6_DTX		                { TYPE(BW RAM) START(0x837F4000) END(0x84DF3FFF) WIDTH(8) }
   DTSX_VERSIONINFO_SDRAM_A6			   		{ TYPE(BW RAM) START(0x84DF4000) END(0x84DF408F) WIDTH(8) }
   //MEM_DMC0_SDRAM_AAC_DATA_A6                 { TYPE(BW RAM) START(0x84DF4090) END(0x84E2ECEF) WIDTH(8) } 
