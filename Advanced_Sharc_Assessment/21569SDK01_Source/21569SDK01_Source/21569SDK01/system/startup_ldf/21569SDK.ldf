  #define MY_SDRAM_SWCODE_TRUEHD_MEM 			MEM_DMC0_SDRAM_TRUEHD_CODE_A4
  
  #define MY_SDRAM_SWCODE_DDP                   MEM_DMC0_SDRAM_DDPLUS_CODE_A4
  #define MY_SDRAM_DDPLUS_DATA_MEM              MEM_DMC0_SDRAM_DDPLUS_DATA_A6
  #define MY_SDRAM_DDPLAS_OAR_MD_DATA_MEM       MEM_DMC0_SDRAM_DDPLAS_OAR_MD_DATA_A6
  
