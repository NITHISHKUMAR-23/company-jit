      dxe_sdram_stack_and_heap_reserve NO_INIT BW
      {
         RESERVE(heaps_and_system_stack_in_L3, heaps_and_system_stack_in_L3_length = 32768, 8)
      } > mem_DMC0_SDRAM_RESERVED_A6
      
      dxe_sdram_stack_and_heap_expand NO_INIT BW
      {         
         RESERVE_EXPAND(heaps_and_system_stack_in_L3, heaps_and_system_stack_in_L3_length, 0, 8)
         ldf_stack_space = heaps_and_system_stack_in_L3;
         ldf_stack_end = (ldf_stack_space + (((heaps_and_system_stack_in_L3_length * 16384) / 32768) - 8));
         ldf_stack_length = ldf_stack_end - ldf_stack_space;
         ldf_heap_space = ldf_stack_end + 8;
         ldf_heap_end = (ldf_heap_space + (((heaps_and_system_stack_in_L3_length * 16384) / 32768) - 8));
         ldf_heap_length = ldf_heap_end - ldf_heap_space;
      } > mem_DMC0_SDRAM_RESERVED_A6
      


