    // If the entire block3 is cache (128KB size) it also includes priority
    // code section.
      
      /*$VDSG<insert-new-sections-for-l1_block0>                */
      /* Text inserted between these $VDSG comments will be preserved */
      /*$VDSG<insert-new-sections-for-l1_block0>                */
      
      #define IV_CODE dxe_iv_code
