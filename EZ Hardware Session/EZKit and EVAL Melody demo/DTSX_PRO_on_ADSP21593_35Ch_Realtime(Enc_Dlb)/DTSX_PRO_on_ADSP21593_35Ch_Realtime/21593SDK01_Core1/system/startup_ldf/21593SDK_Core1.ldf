      Predac_Buff_data BW
      {       
	      INPUT_SECTION_ALIGN(4)  
		  INPUT_SECTIONS( $OBJS_LIBS(Seg_Internal_Predac) )		
      } > mem_block1_Predac      
 
      
      /*$VDSG<insert-new-sections-for-l1_block1>                */
      /* Text inserted between these $VDSG comments will be preserved */
      /*$VDSG<insert-new-sections-for-l1_block1>                */


