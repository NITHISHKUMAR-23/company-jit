   mem_block0_heap_bw             { TYPE(BW RAM) START(0x0026d800) END(0x0026ebff) WIDTH(8) }
   mem_block0_stack_bw            { TYPE(BW RAM) START(0x0026ec00) END(0x0026ffff) WIDTH(8) }

   // ----------------------- L1-Block 1 RAM (1.5 MBit) ------------------------
   // The data cache attached to block 1 caches all the external memory access
   // requests for the DM bus. The size of the cache can be adjusted with a
   // corresponding reduction of the available non-cache L1 space.
   // 128 KB at the end of block 1 is DM cache
   mem_block1_predac_bw         { TYPE(BW RAM) START(0x002c0000) END(0x002c8fff) WIDTH(8) }
   mem_block1_bw                { TYPE(BW RAM) START(0x002c9000) END(0x002cffff) WIDTH(8) }
   
   // ----------------------- L1-Block 2 RAM (1 MBit) --------------------------
   // The data cache attached to block 2 caches all the external memory access
   // requests for the PM bus. If the size of the cache is 128KB, the whole
   // of block 2 is cache.
   //32 KB at the end of block 2 is PM cache
   mem_block2_fft_pm_data          { TYPE(BW RAM) START(0x00300000) END(0x0030214f) WIDTH(8) }
   mem_block2_bw                   { TYPE(BW RAM) START(0x00302150) END(0x00317FFF) WIDTH(8) }
   
   // ----------------------- L1-Block 3 RAM (1 MBit) --------------------------
   // The instruction cache is attached to block 3.
   // 64 KB at the end of block 3 is instruction cache
   mem_block3_bw                  { TYPE(BW RAM) START(0x00380000) END(0x0038ffff) WIDTH(8) }
   
   // ----------------------- L2-RAM (16 MBit) ----------------------------------
   // The 2 MB L2 memory has 8 banks partitioned as follows:
   //  bank1  2000_0000  2003_FFFF   4KB uncached - ICC          (mem_L2B1P1_bw)
   //                               60KB uncached - MCAPI SHARC1 (mem_L2B1P2_bw)
   //                               64KB uncached - MCAPI SHARC0 (mem_L2B1P3_bw)
   //                              128KB cached   - SHARC0     (mem_L2B1toB5_bw)
   //  bank2  2004_0000  2007_FFFF 256KB cached   - SHARC0     (mem_L2B1toB5_bw)
   //  bank3  2008_0000  200B_FFFF 256KB cached   - SHARC0     (mem_L2B1toB5_bw)
   //  bank4  200C_0000  200F_FFFF 256KB cached   - SHARC0     (mem_L2B1toB5_bw)
   //  bank5  2010_0000  2013_FFFF 256KB cached   - SHARC0     (mem_L2B1toB5_bw)
   //  bank6  2014_0000  2017_FFFF 256KB cached   - SHARC1     (mem_L2B6toB8_bw)
   //  bank7  2018_0000  201B_FFFF 256KB cached   - SHARC1     (mem_L2B6toB8_bw)
   //  bank8  201C_0000  201F_DFFF 248KB cached   - SHARC1     (mem_L2B6toB8_bw)
   //         201F_E000  201F_FFFF   8KB cached boot code working area
   //
   // Notes:
   // 1. The boot code claims the last 8KB of L2 SRAM, as working space.
   //    This memory is not bootable, but can be used by the application once
   //    booting is complete (NO_INIT in CCES). Note that if the application
   //    makes use of this space and then calls the Boot Code APIs, the
   //    space may be corrupted.
   
   mem_L2B1P1_bw           		{ TYPE(BW RAM) START(0x20000000) END(0x20000fff) WIDTH(8) }
   mem_L2B1P2_bw           		{ TYPE(BW RAM) START(0x20001000) END(0x2000ffff) WIDTH(8) }
   mem_L2B1P3_bw           		{ TYPE(BW RAM) START(0x20010000) END(0x2001ffff) WIDTH(8) }
   mem_pack_dma_list_bw   		{ TYPE(BW RAM) START(0x20020000) END(0x2005ffff) WIDTH(8) } //Reserved for CORE1 
   mem_L2_library_data          { TYPE(BW RAM) START(0x20060000) END(0x201400ff) WIDTH(8) } //Buffer's should not be allocated memory can be used as Pointers
   mem_L2B6toB8_bw         		{ TYPE(BW RAM) START(0x20140100) END(0x2015e41f) WIDTH(8) }  
   mem_L2_Shared_Memory    		{ TYPE(BW RAM) START(0x2015e420) END(0x2016642f) WIDTH(8) } 
   mem_L2_Customer_bw      		{ TYPE(BW RAM) START(0x20166430) END(0x201a643f) WIDTH(8) } // 2Mbits reserved for customer 
   mem_L2_Kernel          		{ TYPE(BW RAM) START(0x201a6440) END(0x201fdfff) WIDTH(8) }
   mem_L2BC_bw            		{ TYPE(BW RAM) START(0x201fe000) END(0x201fffff) WIDTH(8) }

  #define MY_L2_UNCACHED_MEM mem_L2B1P2_bw
  #define MY_L2_CACHED_MEM   mem_L2B6toB8_bw
   // ----------------------- L3 ------------------------------------------------
   // DMC0 DDR SDRAM memory is partitioned between the cores.
   //
   // Notes
   //  1. Code execution addresses are restricted for the SHARC cores so the
   //     memory allocated cannot be increased or moved.
   //  2. All L3 will be considered cached.
   //  3. When there are two data segments MY_SDRAM_DATA1_MEM is defined to be
   //     the smaller and MY_SDRAM_DATA2_MEM to be the larger one.

   // ----------------------- 128MB DMC0(DDR-A) ---------------------------------
   // 128MB DMC0 DDR SDRAM memory is partitioned as follows:
   //   DDR-A part1 : SHARC0 NW code, 3MB
   //   DDR-A part2 : SHARC1 NW code, 3MB
   //   DDR-A part3 : SHARC0 data, 4MB
   //   DDR-A part4 : SHARC0 VISA code, 3MB
   //   DDR-A part5 : SHARC1 VISA code, 3MB
   //   DDR-A part6 : SHARC0 data, 48MB
   //   DDR-A part7 : SHARC1 data, 64MB
  
     /*$VDSG<insert-new-memory-segments>                          */
   /* Text inserted between these $VDSG comments will be preserved */
   /*$VDSG<insert-new-memory-segments>                          */
   
   mem_DMC0_SDRAM_RESERVED_NW_CODE_A1				{ TYPE(BW RAM) START(0x80000000) END(0x802fffff) WIDTH(8) } //Reserved for #core 1
   mem_DMC0_SDRAM_DTSX_LIB_NW_CODE_A2               { TYPE(BW RAM) START(0x80300000) END(0x8036ffff) WIDTH(8) }
   mem_DMC0_SDRAM_DTSX_KERNEL_NW_CODE_A2            { TYPE(BW RAM) START(0x80370000) END(0x8038000f) WIDTH(8) }
   mem_DMC0_SDRAM_Dolby_NW_CODE_A2                  { TYPE(BW RAM) START(0x80380010) END(0x8040001f) WIDTH(8) }
   mem_DMC0_SDRAM_AURO_NW_CODE_A2                   { TYPE(BW RAM) START(0x80400020) END(0x804199cf) WIDTH(8) }
   mem_DMC0_SDRAM_CODE_NW_A2                        { TYPE(BW RAM) START(0x804199d0) END(0x804699df) WIDTH(8) }
   mem_DMC0_SDRAM_RESERVED_NW_CODE_A2               { TYPE(BW RAM) START(0x804699e0) END(0x805fffff) WIDTH(8) }
   
   mem_DMC0_SDRAM_PREDAC_BW_A3                      { TYPE(BW RAM) START(0x80600000) END(0x8097ffff) WIDTH(8) }
   mem_DMC0_SDRAM_RESERVED_A3                       { TYPE(BW RAM) START(0x80980000) END(0x809fffff) WIDTH(8) }
   
   Mem_DMC0_SDRAM_RESERVED_SW_CODE_A4               { TYPE(BW RAM) START(0x80a00000) END(0x80cfffff) WIDTH(8) } //Reserved for #core 1
   
   mem_DMC0_SDRAM_DTSX_LIB_SW_CODE_A5   			{ TYPE(BW RAM) START(0x80d00000) END(0x80d5ffff) WIDTH(8) }
   mem_DMC0_SDRAM_DTSX_KERNEL_SW_CODE_A5			{ TYPE(BW RAM) START(0x80d60000) END(0x80d7000f) WIDTH(8) }
   mem_DMC0_SDRAM_Dolby_SW_CODE_A5                  { TYPE(BW RAM) START(0x80d70010) END(0x80dfccdf) WIDTH(8) }
   mem_DMC0_SDRAM_AURO_SW_CODE_A5                   { TYPE(BW RAM) START(0x80dfcce0) END(0x80e36cef) WIDTH(8) }
   mem_DMC0_SDRAM_LIBC_SW_CODE_A5                   { TYPE(BW RAM) START(0x80e36cf0) END(0x80e76cff) WIDTH(8) }
   mem_DMC0_SDRAM_CUSTPP_SW_CODE_A5                 { TYPE(BW RAM) START(0x80e76d00) END(0x80e96dff) WIDTH(8) }
   mem_DMC0_SDRAM_Kernel_SW_CODE_A5                 { TYPE(BW RAM) START(0x80e96e00) END(0x80ffffff) WIDTH(8) }
   
   mem_DMC0_SDRAM_RESERVED_DATA_A6                  { TYPE(BW RAM) START(0x81000000) END(0x83ffffff) WIDTH(8) } //Reserved for #core 1
   
   mem_DMC0_SDRAM_DTSX_LIB_DATA_A7					{ TYPE(BW RAM) START(0x84000000) END(0x84297fff) WIDTH(8) }
   mem_DMC0_SDRAM_DTSX_KERNEL_DATA_A7   			{ TYPE(BW RAM) START(0x84298000) END(0x842b7aef) WIDTH(8) }
   mem_DMC0_SDRAM_Dolby_DATA_A7                     { TYPE(BW RAM) START(0x842b7af0) END(0x849f47bf) WIDTH(8) }
   mem_DMC0_SDRAM_AURO_DATA_A7                      { TYPE(BW RAM) START(0x849f47c0) END(0x84b147cf) WIDTH(8) }
   mem_DMC0_SDRAM_LIBC_DATA_A7                      { TYPE(BW RAM) START(0x84b147d0) END(0x84c147df) WIDTH(8) }
   mem_DMC0_SDRAM_CUSTPP_DATA_A7                    { TYPE(BW RAM) START(0x84c147e0) END(0x84e147ef) WIDTH(8) }
   mem_DMC0_SDRAM_KERNEL_DATA_A7                    { TYPE(BW RAM) START(0x84e147f0) END(0x852347ff) WIDTH(8) }
