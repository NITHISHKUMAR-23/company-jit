  #define MY_SDRAM_COMMON_LIB_C_DATA_MEM 		mem_DMC0_SDRAM_LIBC_DATA_A7
  #define MY_SDRAM_CUSTPP_CODE_MEM				mem_DMC0_SDRAM_CUSTPP_SW_CODE_A5
