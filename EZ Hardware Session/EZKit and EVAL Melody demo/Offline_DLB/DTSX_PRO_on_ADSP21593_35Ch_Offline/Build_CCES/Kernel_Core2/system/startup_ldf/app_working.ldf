         ldf_stack_space = heaps_and_system_stack_in_L3;
         ldf_stack_end = (ldf_stack_space + (((heaps_and_system_stack_in_L3_length * 4096) / 8192) - 8));
         ldf_stack_length = ldf_stack_end - ldf_stack_space;
         ldf_heap_space = ldf_stack_end + 8;
         ldf_heap_end = (ldf_heap_space + (((heaps_and_system_stack_in_L3_length * 4096) / 8192) - 8));
         ldf_heap_length = ldf_heap_end - ldf_heap_space;
      } > mem_DMC0_SDRAM_RESERVED_DATA_A7
      
        
